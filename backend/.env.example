# ── VeritasAI Backend — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
APP_VERSION=0.1.0
DEBUG=true

# ── MongoDB ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=veritasai

# ── HuggingFace / Model ───────────────────────────────────────────────────
# Path to your locally fine-tuned model checkpoint, or a HuggingFace Hub ID.
# During development you can use the base model: "roberta-base"
MODEL_PATH=./models/roberta-fakenews
# Set to "cpu" unless you have a CUDA-capable GPU
DEVICE=cpu

# ── News API ──────────────────────────────────────────────────────────────
# Get your free key at: https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here

# ── Google Custom Search API ──────────────────────────────────────────────
# Used for domain authority lookups and cross-referencing.
# Set up at: https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In development, this is the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# ── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10

# ── Resend Transactional Email & OTP ──────────────────────────────────────
# Obtain a free API key at: https://resend.com
# In development, leave blank to print OTPs directly to backend logs.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VeritasAI Security <onboarding@resend.dev>
